{
    "compilerOptions": {
        "target": "es2019",
        "lib": ["es2019", "dom"],
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "types": ["cypress", "node"]
    },
    "include": ["cypress/**/*.ts", "demo/**/*.ts", "cypress.config.ts", "cypress.screenshots.config.ts"]
}
