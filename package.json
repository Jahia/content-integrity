  "license": "JSEL",
  "scripts": {
    "build": "yarn webpack",
    "build:dev": "yarn webpack",
    "build:production": "yarn webpack --mode=production",
    "webpack": "node --max_old_space_size=2048 ./node_modules/webpack/bin/webpack.js",
    "dev": "yarn webpack --watch",
    "watch": "yarn webpack --watch",
    "clean": "rimraf *.log src/main/resources/javascript/apps",
    "clean:all": "yarn clean && rimraf node_modules node"
  },
  "jahia": {
    "remotes": {
      "jahia": "javascript/apps/remoteEntry.js"
    }
  },
  "dependencies": {
    "@apollo/client": "^3.8.2",
    "@jahia/moonstone": "~2.14.2",
    "@jahia/ui-extender": "^1.0.0",
    "graphql": "^15.8.0",
    "i18next": "^21.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^11.18.6",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@jahia/webpack-config": "^1.1.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "rimraf": "^5.0.0",
    "sass": "^1.52.1",
    "sass-loader": "^12.4.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
