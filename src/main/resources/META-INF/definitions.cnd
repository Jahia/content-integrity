<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<integrity = 'http://www.jahia.org/jahia/contentintegrity/nt/1.0'>

[integrity:scanReport] mixin
- integrity:errorsCount (long) protected
- integrity:scannedWorkspace (string) protected
- integrity:executionDate (date) protected
- integrity:moduleVersion (string) protected
- integrity:jahiaVersion (string) protected
- integrity:duration (string) protected
- integrity:countByErrorType (string, textarea) protected
- integrity:executionLog (string, textarea) protected
- integrity:resultsId (string) protected
- integrity:status (string) protected < 'running', 'finished', 'interrupted', 'failed'
- integrity:serverId (string) protected
- integrity:importErrorsCount (long) protected
- integrity:fixedErrors (string) protected multiple

[jnt:contentIntegrityAdminPanel] > jnt:content, jmix:structuredContent, jmix:studioOnly
